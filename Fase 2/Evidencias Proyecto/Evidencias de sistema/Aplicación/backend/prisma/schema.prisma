generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum Role {
  USER
  ADMIN
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD
}

enum VehicleCondition {
  NEW
  USED
}

// ========== MODELS ==========

model User {
  id                    Int                 @id @default(autoincrement())
  email                 String              @unique
  username              String?             @unique
  password              String
  firstName             String
  lastName              String
  phone                 String              @unique
  avatar                String?
  role                  Role                @default(USER)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relaciones
  vehicles              Vehicle[]
  transfersOrigin       VehicleTransfer[]   @relation("TransferOrigin")
  transfersDestination  VehicleTransfer[]   @relation("TransferDestination")

  @@map("users")
}

model Vehicle {
  id            Int                @id @default(autoincrement())
  userId        Int
  brand         String
  model         String
  year          Int
  licensePlate  String             @unique
  color         String
  engine        String
  currentKm     Int                @default(0)
  condition     VehicleCondition   @default(USED)
  purchaseDate  DateTime?
  purchasePrice Decimal?           @db.Decimal(10, 2)
  status        VehicleStatus      @default(ACTIVE)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  documents     VehicleDocument[]
  maintenances  Maintenance[]
  fuelRefills   FuelRefill[]
  seguros       VehicleInsurance[]
  soaps         Soap[]
  transfers     VehicleTransfer[]
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([licensePlate])
  @@map("vehicles")
}

model MaintenanceType {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  maintenances Maintenance[]

  @@map("tipos_mantenimiento")
}

model Maintenance {
  id                Int             @id @default(autoincrement())
  vehicleId         Int
  maintenanceTypeId Int
  date              DateTime
  description       String
  workshopName      String?
  cost              Decimal?        @db.Decimal(10, 2)
  mileage           Int
  observations      String?
  status            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([maintenanceTypeId])
  @@index([date])
  @@map("mantenimientos")
}

model VehicleDocument {
  id             Int       @id @default(autoincrement())
  vehicleId      Int
  documentType   String
  documentNumber String?
  fileUrl        String?
  issueDate      DateTime?
  expiryDate     DateTime?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("documentos_vehiculo")
}

model VehicleTransfer {
  id                Int      @id @default(autoincrement())
  vehicleId         Int
  originUserId      Int
  destinationUserId Int
  transferEmail     String
  transferCode      String   @unique
  status            String   @default("pending")
  message           String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  destinationUser   User     @relation("TransferDestination", fields: [destinationUserId], references: [id])
  originUser        User     @relation("TransferOrigin", fields: [originUserId], references: [id])
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([originUserId])
  @@index([destinationUserId])
  @@index([transferCode])
  @@map("transferencias_vehiculos")
}

model VehicleInsurance {
  id            Int      @id @default(autoincrement())
  vehicleId     Int
  compania      String
  tipoCobertura String
  costo         Decimal  @db.Decimal(10, 2)
  deducible     Decimal  @db.Decimal(10, 2)
  fechaInicio   DateTime
  fechaFin      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("seguros_vehiculares")
}

model Soap {
  id            Int      @id @default(autoincrement())
  vehicleId     Int
  compania      String
  lugarCompra   String?
  numeroPoliza  String?
  fechaVigencia DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("soaps")
}

model FuelRefill {
  id            Int       @id @default(autoincrement())
  vehicleId     Int
  date          DateTime
  liters        Decimal   @db.Decimal(10, 2)
  pricePerLiter Decimal   @db.Decimal(10, 2)
  totalCost     Decimal   @db.Decimal(10, 2)
  station       String
  currentKm     Int
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@map("recargas_combustible")
}
